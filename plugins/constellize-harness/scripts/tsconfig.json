{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
